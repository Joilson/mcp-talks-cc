NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Embedding model (HF local, ~600MB cold-download)
EMBED_MODEL=Xenova/bge-m3
EMBED_DIM=1024

# Paths (opcionais — defaults dinâmicos baseados no seu $HOME)
#   CLAUDE_HOME default: ~/.claude
#   CODE_HOME   default: ~/Documents/code
#   CACHE_DIR   default: ~/.cache/mcp-talks-cc
# Descomente só se seus diretórios fugirem do padrão.
# CLAUDE_HOME=
# CODE_HOME=
# CACHE_DIR=

# Consumo de recursos. Defaults servem pra máquina folgada; com pouca RAM ou várias
# sessões do Claude abertas, ajuste (ver README, "Consumo de recursos").
#   EMBED_THREADS: threads do onnx (embedding). Sem isto, o hook usa metade dos cores
#     e o MCP server usa todos. 2 ou 3 costuma bastar, o bge-m3 escala mal além disso.
#   MCP_TALKS_PRELOAD=1: o MCP server carrega o modelo ao subir (padrão: só na 1ª
#     busca ou push). Custa ~0,5-0,7GB (RSS, Linux) a ~1,3GB (footprint, macOS)
#     de RAM por sessão aberta.
#   MCP_TALKS_LOWPRI=0: desliga nice/ionice/taskpolicy no hook de ingest (padrão: ligado).
# EMBED_THREADS=2
# MCP_TALKS_PRELOAD=1
# MCP_TALKS_LOWPRI=0

# Distilação automática (v0.3): o hook de SessionStart destila sessões fechadas em
# nós Decision usando `claude -p` com Haiku. GASTA TOKENS DA SUA CONTA (~10k por
# sessão, até 5 recentes + 3 antigas por sessão aberta). Desligado por padrão.
# Manual, sem ligar isto: npm run distill -- --limit=10
# MCP_TALKS_DISTILL=1

# Vínculo task -> epic (link:epics). Linha [task] e regex rodam sempre (sem
# custo). A parte com Haiku (maior precisão: pega o que não é literal) gasta
# ~2k tokens por sessão que cita epic. Opt-in próprio; sem a linha, segue o
# MCP_TALKS_DISTILL. Muda com: npm run upgrade -- --epic-llm=on|off
# MCP_TALKS_EPIC_LLM=1
# Sessões por SessionStart:
# MCP_TALKS_EPIC_LINK_PER_RUN=5
# Epic "balde" (filhas sem relação) é detectado pelo título; corrija aqui:
# MCP_TALKS_EPIC_BUCKETS=EDC-341,EDC-3040
# MCP_TALKS_EPIC_NOT_BUCKETS=

# OpenRouter (FASE F opcional - nao usado no MVP)
# OPENROUTER_API_KEY=
